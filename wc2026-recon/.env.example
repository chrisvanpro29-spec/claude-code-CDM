# Copier ce fichier en `.env` et renseigner les clés.
# Le `.env` réel n'est JAMAIS commité (voir .gitignore).
# Aucune clé n'est en dur dans le code : tout passe par ces variables.

# football-data.org — REST v4, clé gratuite : https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# the-odds-api — clé gratuite : https://the-odds-api.com/
ODDS_API_KEY=

# Source à promesses extraordinaires (probe H / quarantine).
# URL de base + clé éventuelle. Laisser vide si rien à sonder.
QUARANTINE_BASE_URL=
QUARANTINE_API_KEY=
